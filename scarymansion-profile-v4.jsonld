      }
    }
  ],
  "templates": [
    {
      "id": "https://github.com/blakeplock/ScaryMansion/xapi/templates/v4/session-started",
      "type": "StatementTemplate",
      "inScheme": "https://github.com/blakeplock/ScaryMansion/xapi/v4",
      "prefLabel": {
        "en": "session started"
      },
      "definition": {
        "en": "Occurs after a player enters three initials and presses Enter; initializes registration and session."
      },
      "verb": "https://github.com/blakeplock/ScaryMansion/xapi/verbs/started",
      "objectActivityType": "https://github.com/blakeplock/ScaryMansion/xapi/activity-types/session",
      "rules": [
        {
          "location": "$.context.registration",
          "presence": "included"
        },
        {
          "location": "$.context.contextActivities.category[*].id",
          "presence": "included",
          "any": [
            "https://github.com/blakeplock/ScaryMansion/xapi/v4"
          ]
        },
        {
          "location": "$.context.extensions['https://github.com/blakeplock/ScaryMansion/xapi/extensions/session-id']",
          "presence": "included"
        },
        {
          "location": "$.context.extensions['https://github.com/blakeplock/ScaryMansion/xapi/extensions/event-id']",
          "presence": "included",
          "any": [
            "session-started"
          ]
        }
      ]
    },
    {
      "id": "https://github.com/blakeplock/ScaryMansion/xapi/templates/v4/room-entered",
      "type": "StatementTemplate",
      "inScheme": "https://github.com/blakeplock/ScaryMansion/xapi/v4",
      "prefLabel": {
        "en": "room entered"
      },
      "definition": {
        "en": "Record every entered room including revisits and transitions, preserving floor and x/y coordinates."
      },
      "verb": "https://github.com/blakeplock/ScaryMansion/xapi/verbs/entered",
      "objectActivityType": "https://github.com/blakeplock/ScaryMansion/xapi/activity-types/room",
      "rules": [
        {
          "location": "$.context.registration",
          "presence": "included"
        },
        {
          "location": "$.context.contextActivities.category[*].id",
          "presence": "included",
          "any": [
            "https://github.com/blakeplock/ScaryMansion/xapi/v4"
          ]
        },
        {
          "location": "$.context.extensions['https://github.com/blakeplock/ScaryMansion/xapi/extensions/session-id']",
          "presence": "included"
        },
        {
          "location": "$.context.extensions['https://github.com/blakeplock/ScaryMansion/xapi/extensions/event-id']",
          "presence": "included",
          "any": [
            "room-entered"
          ]
        }
      ]
    },
